{
  "name": "kitchen-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base /kitchen-inventory/ --outDir outputs/github-pages",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/model.test.ts src/lib/naturalLanguage.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0",
    "typescript": "~5.9.3",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0"
  }
}
